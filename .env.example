# Copy to bridge-state/trader.env on the Pi (the compose file mounts it as /state/.env).
# ntfy: the phone subscribes to NTFY_URL/NTFY_TOPIC. On the public server the topic
# name is the only thing between your suggestions and the world: make it long and random.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Only for a self-hosted ntfy with access control.
NTFY_TOKEN=
# Where "Open in app" on a notification goes (your Tailscale address of the dashboard).
APP_URL=http://<your-pi>:3000
# Seconds between passes during market hours, on the clock (900 = :00, :15, :30, :45).
# Closes at 50% are checked every pass.
TRADER_INTERVAL=900
# Entry slots: the hours (Eastern) at which new puts, covered calls and notes are
# evaluated, once each, for every account. 11..15 ET = 9:00 to 1:00 Mountain.
TRADER_ENTRY_HOURS=11,12,13,14,15
# Minutes after the hour a slot stays open, so a late scan still gets its turn.
TRADER_ENTRY_SLOT_MINUTES=50
# A Quant scan older than this many seconds before the slot opened is stale;
# the trader waits (and asks the bridge for a new one) rather than use it.
TRADER_SCAN_MAX_AGE=1800
# Accounts to run the rules for, by snapshot id, comma-separated; blank = every
# account the dashboard shows (the Auto Trader paper account runs on its own).
TRADER_ACCOUNTS=
# The Auto Trader paper account: the same rules traded for pretend money in a
# manual account the dashboard prices and shows like any other. 0 turns it off.
TRADER_PAPER=1
PAPER_CASH=400000
PAPER_LABEL=Auto Trader
# The portfolio hedge: HEDGE_SYM puts bought at a portfolio high (VIX under HEDGE_VIX_MAX, at
# least HEDGE_MIN_INVESTED of the account committed), ~HEDGE_OTM below spot, HEDGE_DTE_LO
# to HEDGE_DTE_HI days out, notional HEDGE_FRAC of committed capital; sold at HEDGE_TP
# times cost or inside HEDGE_CLOSE_DTE days of expiry. 0 turns it off.
TRADER_HEDGE=1
HEDGE_SYM=SMH
HEDGE_FRAC=0.5
HEDGE_OTM=0.10
HEDGE_TP=2.5
HEDGE_VIX_MAX=20
HEDGE_MIN_INVESTED=0.25
HEDGE_DTE_LO=180
HEDGE_DTE_HI=365
HEDGE_CLOSE_DTE=60
